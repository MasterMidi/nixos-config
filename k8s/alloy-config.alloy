// Alloy configurations form a graph: components expose outputs such as
// "targets" or "receiver", and references connect those outputs together.

// Watch the Kubernetes API for Jellyfin pod containers. This discovers pod
// metadata only; loki.source.kubernetes below opens the actual log streams.
discovery.kubernetes "k8s_pods" {
  role = "pod"
  selectors {
    role = "pod"
    field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
  }
}

// Filter the discovered targets and turn temporary Kubernetes __meta labels
// into normal labels that remain attached to each collected log entry.
discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.k8s_pods.targets

	// Copy useful Kubernetes metadata to labels with shorter names.
	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		action = "replace"
		target_label  = "namespace"
	}

	// Pod names change on every Deployment rollout. Keeping this label makes it
	// easy to identify a replica, but creates a new Loki stream for each pod.
	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		action = "replace"
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		action = "replace"
		target_label  = "container"
	}

	rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    action = "replace"
    target_label = "app"
  }

	// rule {
	// 	target_label = "job"
	// 	replacement  = "media-stack/jellyfin"
	// }
}

discovery.relabel "jellyfin" {
	targets = discovery.relabel.pod_logs.output

	// A pod may have init containers or sidecars. Keep only Jellyfin itself.
	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "jellyfin"
		action        = "keep"
	}
}

// Tail the selected container stdout/stderr streams through the Kubernetes
// pods/log API. No host log mount or privileged Alloy container is required.
loki.source.kubernetes "jellyfin" {
	targets    = discovery.relabel.jellyfin.output
	forward_to = [loki.process.jellyfin.receiver]
}

// Parse and enrich every Jellyfin entry before forwarding it to a destination.
loki.process "jellyfin" {

	// Parse the JSON line and place selected fields in Alloy's extracted-values
	// map. This does not rewrite the original JSON log line.
	stage.json {
		expressions = {
			timestamp         = "timestamp",
			level             = "level",
			template_hash     = "templateHash",
			source            = "source",
			thread_id         = "threadId",
			trace_id          = "traceId",
			span_id           = "spanId",
			service           = "properties.service",
			component         = "properties.component",
			dotnet_event_id   = "properties.EventId.Id",
			dotnet_event_name = "properties.EventId.Name",
		}
	}

	// Use Jellyfin's event time instead of the time at which Alloy received the
	// line. Invalid or absent timestamps retain the collection timestamp.
	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	// Loki indexes labels, so only promote bounded, frequently queried fields.
	// Avoid putting trace IDs, thread IDs, or arbitrary properties here.
	stage.labels {
		values = {
			level     = "",
			service   = "",
			component = "",
		}
	}

	// Structured metadata remains searchable with each entry without creating a
	// separate indexed stream for every high-cardinality value.
	stage.structured_metadata {
		values = {
			template_hash     = "",
			source            = "",
			thread_id         = "",
			trace_id          = "",
			span_id           = "",
			dotnet_event_id   = "",
			dotnet_event_name = "",
		}
	}

	forward_to = [loki.echo.jellyfin.receiver]
}

// loki.source.kubernetes_events tails events from the Kubernetes API and converts them
// into log lines to forward to other Loki components.
loki.source.kubernetes_events "cluster_events" {
  job_name   = "integrations/kubernetes/eventhandler"
  log_format = "logfmt"
  forward_to = [
    loki.process.cluster_events.receiver,
  ]
}

// loki.process receives log entries from other loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "cluster_events" {
  forward_to = [loki.echo.events.receiver]

  stage.static_labels {
    values = {
      cluster = "media-server",
    }
  }

  stage.labels {
    values = {
      kubernetes_cluster_events = "job",
    }
  }
}

// Debug-only destination: write processed entries to the Alloy container's
// stdout. This provides no persistence or querying and should eventually be
// replaced with a loki.write component.
loki.echo "jellyfin" { }

loki.echo "events" { }
